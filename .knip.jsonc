{
  "entry": ["functions/auth/*.ts"],
  "ignore": ["src/honeybadgerStub.ts", "src/assets/stylesheets/vendor/**"],
  "ignoreBinaries": ["break"], // Lighthouse false positive
  "ignoreDependencies": [
    "@cloudflare/workers-types", // used by functions/*
  ],
  "project": ["**/*.{js,ts,tsx,sass,scss}"],
}
